# ==============================================================================
# SIH 2026: AI-Based Landslide Early Warning & Risk Monitoring System (NER)
# Master Environment Configuration Template
# Problem Statement: SIH26001 | Ministry: MDoNER
# ==============================================================================

# Core System
ENVIRONMENT=development
PROJECT_NAME="NER Landslide Early Warning System"
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=sih_2026_super_secret_jwt_key_ner_disaster_mgmt

# PostGIS Spatial Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_dev
POSTGRES_DB=landslide_ner
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_dev@localhost:5432/landslide_ner
DOCKER_DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_dev@postgis:5432/landslide_ner

# Redis Broker & Celery Queue
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Microservice Endpoints
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ML_ENGINE_URL=http://localhost:8001
ML_ENGINE_PORT=8001
MOCK_SERVER_URL=http://localhost:8005

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live-dashboard
NEXT_PUBLIC_DEFAULT_LANG=en

# ==============================================================================
# REAL DATA SOURCES (TODO: connect real API here - Defaults to mock when empty)
# ==============================================================================

# 1. IMD (India Meteorological Department) AWS & Pune Portal
